{
  "expo": {
    "name": "VStride",
    "slug": "VStride-BMITracker",
    "owner": "davinrisky.sci",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpeg",
    "splash": {
          "image": "./assets/images/icon.jpeg",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        },
    "scheme": "VStrideapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.vstride.bmitracker", 
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.jpeg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.jpeg"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PacePulse memerlukan akses lokasi untuk merekam rute aktivitas."
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "a0adcf53-da5b-48da-af48-aae0e3e49516"
      }
    }
  }
}